{
  "name": "entroximer-bot",
  "description": "A Discord bot for trying the Entroximer engine through its client library",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run --conditions=entroximer-source src/index.ts",
    "register": "bun run --conditions=entroximer-source scripts/register.ts",
    "smoke": "bun run --conditions=entroximer-source scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "entroximer-client": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
