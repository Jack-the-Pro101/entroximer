{
  // Type-checks the library and its tests; `tsconfig.build.json` compiles the library to `dist/`.
  "compilerOptions": {
    // Node 22 and Bun run all of ES2024
    "target": "ES2024",
    "lib": ["ES2024"],
    // Node's own module rules: the output runs on Node and Bun and in every bundler
    "module": "NodeNext",
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "test"]
}
