# Entroximer engine image; works with Podman and Docker. Build from this directory:
#
#   podman build -t entroximer-engine .
#   docker build -f Containerfile -t entroximer-engine .
#
# The image is for the building machine's CPU unless `--platform` says otherwise. An image for
# another CPU still runs there, emulated, but about ten times slower: too slow to play audio
# smoothly. For an ARM server, build on an x86 machine with
#
#   podman build --platform linux/arm64 -t entroximer-engine .
#
# The engine is cross-compiled natively; only the final stage's package installs run emulated,
# which needs qemu-user-static on the building machine (`dnf install qemu-user-static-aarch64`).
# Then copy it over, e.g. `podman image scp localhost/entroximer-engine user@server::`.
#
# yt-dlp is not part of the image: the engine installs it into the data volume on first start
# and keeps it updated (ENTROXIMER_YTDLP_* settings), so YouTube fixes never need a rebuild.
# Update on demand with `podman exec <container> entroximer ytdlp update`.

ARG RUST_VERSION=1.99
ARG DEBIAN_RELEASE=trixie
# yt-dlp needs a JavaScript runtime to solve YouTube's player challenges
ARG DENO_VERSION=2.9.8

# Runs on the building machine's CPU and cross-compiles for the image's when they differ: Rust
# compiled under emulation would take hours
FROM --platform=$BUILDPLATFORM docker.io/library/rust:${RUST_VERSION}-slim-${DEBIAN_RELEASE} AS build
ARG TARGETARCH
# /cross.env tells cargo and the C compiler of `ring` which CPU to build for. libopus is linked
# statically from a prefix holding only its archive, so the runtime image does not need it
# (found through pkg-config instead, a cross build would link it dynamically)
RUN set -eu \
 && case "$TARGETARCH" in \
      amd64) cpu=x86_64 ;; \
      arm64) cpu=aarch64 ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && target=$cpu-unknown-linux-gnu \
 && install -d /opt/opus/lib \
 && ln -s "/usr/lib/$cpu-linux-gnu/libopus.a" /opt/opus/lib/libopus.a \
 && { echo "export CARGO_BUILD_TARGET=$target"; \
      echo "export LIBOPUS_NO_PKG=1 LIBOPUS_LIB_DIR=/opt/opus"; \
    } > /cross.env \
 && packages="libopus-dev:$TARGETARCH" \
 && if [ "$(uname -m)" != "$cpu" ]; then \
      dpkg --add-architecture "$TARGETARCH"; \
      packages="$packages gcc-$(echo $cpu | tr _ -)-linux-gnu libc6-dev-$TARGETARCH-cross"; \
      { echo "export CARGO_TARGET_$(echo $target | tr a-z- A-Z_)_LINKER=$cpu-linux-gnu-gcc"; \
        echo "export CC_$(echo $target | tr - _)=$cpu-linux-gnu-gcc"; \
        echo "export AR_$(echo $target | tr - _)=$cpu-linux-gnu-ar"; \
      } >> /cross.env; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends $packages \
 && rm -rf /var/lib/apt/lists/* \
 && rustup target add "$target"
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    . /cross.env \
 && cargo build --release --locked -p entroximer-server \
 && install -D -m 0755 "target/$CARGO_BUILD_TARGET/release/entroximer" /out/entroximer

FROM docker.io/denoland/deno:bin-${DENO_VERSION} AS deno

FROM docker.io/library/debian:${DEBIAN_RELEASE}-slim
# python3-venv lets the engine install yt-dlp at runtime; tini reaps the processes yt-dlp
# leaves behind (ffmpeg, deno) and forwards signals
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates ffmpeg python3 python3-venv tini \
 && rm -rf /var/lib/apt/lists/*
COPY --from=deno /deno /usr/local/bin/deno
COPY --from=build /out/entroximer /usr/local/bin/entroximer

RUN groupadd --gid 10001 entroximer \
 && useradd --uid 10001 --gid 10001 --home-dir /var/lib/entroximer --create-home entroximer \
 && install -d -o entroximer -g entroximer /var/cache/entroximer
USER entroximer

# MALLOC_ARENA_MAX: glibc otherwise keeps freed memory in an arena per thread, and the engine's
# memory grows with every track played (tested: 25 MB after 30 tracks with 2 arenas, 57 MB and
# rising without)
ENV MALLOC_ARENA_MAX=2 \
    ENTROXIMER_HOST=0.0.0.0 \
    ENTROXIMER_PORT=2333 \
    ENTROXIMER_DATA_DIR=/var/lib/entroximer \
    ENTROXIMER_YTDLP_MANAGED=true \
    ENTROXIMER_CACHE_DIR=/var/cache/entroximer \
    ENTROXIMER_LOG_FORMAT=json \
    RUST_LOG=info,songbird=warn
# The managed yt-dlp lives in the data volume, so it survives restarts and image upgrades.
# The packet cache spills to the cache volume: put it on fast disk, never a RAM-backed tmpfs.
VOLUME ["/var/lib/entroximer", "/var/cache/entroximer"]
EXPOSE 2333

# Honoured by Docker, and by Podman for images built with `--format docker`;
# compose.yaml declares the same check for both.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["entroximer", "healthcheck"]
ENTRYPOINT ["/usr/bin/tini", "--", "entroximer"]
CMD ["serve"]
